{
  "name": "libredb-studio-rancher-extension",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@rancher/shell": "3.0.14"
  },
  "devDependencies": {
    "@rancher/cypress": "1.0.12",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/webpack-env": "1.18.8",
    "@vue/test-utils": "2.5.1",
    "@vue/vue3-jest": "29.2.6",
    "babel-jest": "30.5.2",
    "babel-plugin-transform-require-context": "0.2.0",
    "cypress": "16.2.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "ts-jest": "29.4.15",
    "vue-tsc": "3.3.13"
  },
  "resolutions": {
    "@types/node": "~25.3.0",
    "@types/lodash": "4.17.27",
    "**/@yarnpkg/core": "4.9.1",
    "**/dompurify": "3.4.17",
    "**/diff2html/diff": "5.2.2",
    "**/frontmatter-markdown-loader/markdown-it": "14.3.3",
    "**/@vue/component-compiler-utils/postcss": "8.5.32",
    "**/simple-update-notifier/semver": "7.8.5",
    "**/serialize-javascript": "7.1.4",
    "**/patch-package/tmp": "0.2.7",
    "**/webpack-dev-server/webpack-dev-middleware": "7.4.6",
    "**/cookie-universal/cookie": "0.7.2",
    "**/uuid": "11.1.1",
    "**/@percy/core/fast-xml-parser": "5.11.2"
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "lint": "./node_modules/@rancher/shell/scripts/lint --max-warnings 0 --ext .js,.ts,.vue .",
    "typecheck": "vue-tsc --noEmit -p pkg/libredb-studio/tsconfig.json",
    "clean": "./node_modules/@rancher/shell/scripts/clean",
    "test": "jest",
    "test:ci": "NODE_OPTIONS=--max_old_space_size=8192 jest --silent",
    "test:coverage": "NODE_OPTIONS=--max_old_space_size=8192 jest --silent --coverage",
    "build-pkg": "./node_modules/@rancher/shell/scripts/build-pkg.sh",
    "serve-pkgs": "./node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "./node_modules/@rancher/shell/scripts/extension/publish",
    "parse-tag-name": "./node_modules/@rancher/shell/scripts/extension/parse-tag-name",
    "e2e": "scripts/e2e/run.sh",
    "typecheck:e2e": "tsc --noEmit -p cypress/tsconfig.json"
  },
  "description": "Development app for the LibreDB Studio Rancher UI extension",
  "license": "MIT"
}
