{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["cypress", "cypress-real-events", "node"]
  },
  "include": ["**/*.ts", "../cypress.config.ts", "../node_modules/@rancher/cypress/globals.d.ts"]
}
